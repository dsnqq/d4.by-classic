<modification>
    
    <id><![CDATA[__FINAL_NAME__]]></id>
    <version><![CDATA[__VERSION__]]></version>
    <author><![CDATA[__AUTHOR__]]></author>
    <vqmver><![CDATA[__VQMOD_VERSION__]]></vqmver>
    
    <code>02d3f</code>
    <name>feofan.net</name>
    <link>feofan.net</link>
    
    <!-- 
    call_install_or_uninstall_from_oc22_module
    
    install on opencart 2.3 only
    
    No need for older versions of opencart
     -->
    <file error="skip" name="admin/controller/extension/extension/module.php">
        <operation>
            <search position="after"><![CDATA[// Call install method if it exsits]]></search>
            <add><![CDATA[
            $this->load->controller('module/' . $this->request->get['extension'] . '/install');
            ]]></add>
        </operation>
        
        <operation>
            <search position="after"><![CDATA[// Call uninstall method if it exsits]]></search>
            <add><![CDATA[
            $this->load->controller('module/' . $this->request->get['extension'] . '/uninstall');
            ]]></add>
        </operation>
        
        <!-- use old edit url  -->
        <operation>
            <search position="replace"><![CDATA['edit'      => $this->url->link('extension/module/' . $extension, 'token=' . $this->session->data['token'], true)]]></search>
            <add><![CDATA[
            'edit'      => strpos($file, 'controller/module/') > 0 ? $this->url->link('module/' . $extension, 'token=' . $this->session->data['token'], true) : $this->url->link('extension/module/' . $extension, 'token=' . $this->session->data['token'], true)
            ]]></add>
        </operation>
    </file>
    
</modification>