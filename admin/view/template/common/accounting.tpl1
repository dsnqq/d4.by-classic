<script>
    $(document).ready(function() {
        // Сброс фильтров
        $('#reset-filters').click(function() {
            $('#filter-form')[0].reset();
            $('#filter-form').submit();
        });

        // Экспорт в CSV
        $('#export-csv').click(function() {
            window.location.href = 'index.php?route=report/deleted/export&token=<?php echo $token; ?>&' + $('#filter-form').serialize();
        });

        $("input.date-filter").datetimepicker({
            pickTime: false,           // Не показывать выбор времени[citation:3]
            format: "YYYY-MM-DD",      // Формат даты[citation:4]
            keepInvalid: true,         // Сохранять невалидные значения[citation:3]
            language: 'ru',            // Русский язык интерфейса[citation:5]
            weekStart: 1,              // Начало недели с понедельника[citation:4]
            todayBtn: true,            // Кнопка "Сегодня"
            todayHighlight: true,      // Подсветка сегодняшней даты
            autoclose: true            // Закрывать после выбора даты[citation:3]
        });
    });
</script>

