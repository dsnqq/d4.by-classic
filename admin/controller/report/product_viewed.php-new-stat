    public function getProductsViewsFromApi($start = 0, $limit = 100)
    {
        $page = floor($start / $limit) + 1; // вычисляем страницу для API

        $url = 'https://service.d4.by/api/product-statistics?page=' . $page;

        // Инициализация CURL
        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);

        $response = curl_exec($ch);
        curl_close($ch);

        $data = json_decode($response, true);

        if ($data) {
            return $data;
        }
    }

    /**
     * Получение статистики просмотров по месяцам через API Laravel
     */
    public function getProductsStatisticsFromApi($yearPage = 1)
    {
        $url = 'https://service.d4.by/api/product-statistics-year?year=' . $yearPage;

        $ch = curl_init();
        curl_setopt($ch, CURLOPT_URL, $url);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_TIMEOUT, 10); // таймаут 10 сек

        $response = curl_exec($ch);
        curl_close($ch);

        $data = json_decode($response, true);

        return $data['data'];
    }

    /**
     * Основной метод для формирования массива просмотров для OpenCart
     */
    public function getProductsAll()
    {
        $countAllArray = [];

        // Получаем первую страницу API
        $getProductsAll = $this->getProductsStatisticsFromApi(1);

        foreach ($getProductsAll as $monthItem) {
            $countAllArray[$monthItem['month']] = [
                'views' => $monthItem['views'],
                'unique_products' => $monthItem['unique_products']
            ];
        }

        // Сортируем по убыванию месяца
        $countAllArray = array_reverse($countAllArray, true);

        return $countAllArray;
    }

	public function reset() {
		$this->load->language('report/product_viewed');

		if (!$this->user->hasPermission('modify', 'report/product_viewed')) {
			$this->session->data['error'] = $this->language->get('error_permission');
		} else {
			$this->load->model('report/product');

			$this->model_report_product->reset();

			$this->session->data['success'] = $this->language->get('text_success');
		}

		$this->response->redirect($this->url->link('report/product_viewed', 'token=' . $this->session->data['token'], true));
	}
}