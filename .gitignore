/system/product_views.log

# Docker/local env — не коммитить
.env

# ionCube loader binary — скачивается вручную (get-loader.ioncube.com)
/.docker/ioncube/*.so

# Дамп БД — не коммитить, хранить локально в .docker/mysql/
/.docker/mysql/*.sql

