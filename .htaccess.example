# =============================================================================
# Скопируйте этот файл в .htaccess:
#   cp .htaccess.example .htaccess
#
# .htaccess не коммитится в git — только .htaccess.example.
#
# ВАЖНО:
# - Этот файл нужен только для Apache-серверов (хостинг, cPanel и т.п.)
# - В Docker используется Nginx (.docker/nginx/opencart.conf) — .htaccess игнорируется
# - Замените YOUR_DOMAIN.com на реальный домен
# - Блок "cPanel-generated" в конце — специфичен для cPanel-хостинга.
#   На других серверах (ISPmanager, VPS с чистым Apache) его нужно убрать или адаптировать.
# =============================================================================

# bad bots
SetEnvIfNoCase User-Agent "MJ12bot" bad_bot
SetEnvIfNoCase User-Agent "AhrefsBot" bad_bot
SetEnvIfNoCase User-Agent "LinkpadBot" bad_bot
SetEnvIfNoCase User-Agent "BOT for JCE" bad_bot
SetEnvIfNoCase User-Agent "{" bad_bot
SetEnvIfNoCase User-Agent "SiteSucker" bad_bot
SetEnvIfNoCase User-Agent "MegaIndex" bad_bot
SetEnvIfNoCase User-Agent "OpenLinkProfiler" bad_bot
SetEnvIfNoCase User-Agent "SemrushBot" bad_bot
SetEnvIfNoCase User-Agent "Comparserbot" bad_bot
SetEnvIfNoCase User-Agent "BLEXBot" bad_bot
SetEnvIfNoCase User-Agent "JobboerseBot" bad_bot
SetEnvIfNoCase User-Agent "okhttp" bad_bot

# Vulnerability Scanners
SetEnvIfNoCase User-Agent "Acunetix" bad_bot
SetEnvIfNoCase User-Agent "FHscan" bad_bot

<Limit GET POST HEAD>
Order Allow,Deny
Allow from all
Deny from env=bad_bot
</Limit>

Options +FollowSymlinks

# Prevent Directory listing
Options -Indexes

# Prevent Direct Access to files
<FilesMatch "(?i)((\.tpl|\.ini|\.log|(?<!robots)\.txt))">
 Require all denied
</FilesMatch>

# SEO URL Settings
RewriteEngine On
RewriteBase /
RewriteRule ^sitemap.xml$ index.php?route=feed/google_sitemap&multi&limit=5000 [L]
RewriteRule ^googlebase.xml$ index.php?route=extension/feed/google_base [L]
RewriteRule ^system/download/(.*) index.php?route=error/not_found [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !.*\.(ico|gif|jpg|jpeg|png|js|css)
RewriteRule ^([^?]*) index.php?_route_=$1 [L,QSA]

# Редирект с ?page=1 на /
RewriteCond %{QUERY_STRING} ^page=1$
RewriteRule ^(.*)$ https://YOUR_DOMAIN.com/$1? [R=301,L]

# Заглушка для index.php
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php\ HTTP/
RewriteRule ^index\.php$ https://%{HTTP_HOST}/ [R=301,L]

# Редирект с www на без www
RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
RewriteRule (.*) https://%1/$1 [R=permanent,L]

# Редирект с http на https (раскомментировать на продакшне)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

### PHP-настройки через .htaccess (если хостинг разрешает)
php_value max_execution_time 300

# Кэширование в браузере
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=43200"
    </FilesMatch>
    <FilesMatch "\.(js|css|txt)$">
        Header set Cache-Control "max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(flv|swf|ico|gif|jpg|jpeg|png|webp)$">
        Header set Cache-Control "max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(pl|php|cgi|spl|scgi|fcgi)$">
        Header unset Cache-Control
    </FilesMatch>
    Header always set Access-Control-Allow-Origin "*"
</IfModule>

# WebP MIME-тип (для Apache < 2.4 без встроенного определения)
<IfModule mod_mime.c>
    AddType image/webp .webp
</IfModule>

# Gzip-сжатие
AddOutputFilterByType DEFLATE text/plain
AddOutputFilterByType DEFLATE text/html
AddOutputFilterByType DEFLATE text/xml
AddOutputFilterByType DEFLATE text/css
AddOutputFilterByType DEFLATE application/xml
AddOutputFilterByType DEFLATE application/xhtml+xml
AddOutputFilterByType DEFLATE application/rss+xml
AddOutputFilterByType DEFLATE application/javascript
AddOutputFilterByType DEFLATE application/x-javascript

# =============================================================================
# БЛОК ДЛЯ cPANEL-ХОСТИНГОВ ТОЛЬКО (ea-php80, lsapi)
# Если вы не используете cPanel — удалите всё ниже.
# На чистом Apache/VPS этот блок не нужен и может вызвать ошибки.
# =============================================================================

# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php80___lsphp .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# BEGIN cPanel-generated php ini directives, do not edit
<IfModule php7_module>
   php_value default_charset "UTF-8"
   php_flag display_errors Off
   php_value max_execution_time 300
   php_value max_input_time 600
   php_value max_input_vars 10000
   php_value memory_limit 512M
   php_value post_max_size 512M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php80"
   php_value upload_max_filesize 128M
</IfModule>
<IfModule lsapi_module>
   php_value default_charset "UTF-8"
   php_flag display_errors Off
   php_value max_execution_time 300
   php_value max_input_time 600
   php_value max_input_vars 10000
   php_value memory_limit 512M
   php_value post_max_size 512M
   php_value session.gc_maxlifetime 1440
   php_value session.save_path "/var/cpanel/php/sessions/ea-php80"
   php_value upload_max_filesize 128M
</IfModule>
# END cPanel-generated php ini directives, do not edit
