# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
#
# .env не коммитится в git — только .env.example.

# Пароль root-пользователя MySQL (используется только внутри Docker)
MYSQL_ROOT_PASSWORD=change_me_root

# Название базы данных
MYSQL_DATABASE=dby_bd

# Пользователь БД (должен совпадать с DB_USERNAME в config.php)
MYSQL_USER=dby_user

# Пароль пользователя БД (должен совпадать с DB_PASSWORD в config.php)
MYSQL_PASSWORD=change_me_password

# Необязательно — лимит памяти PHP (по умолчанию 512M)
# PHP_MEMORY_LIMIT=512M

# Необязательно — альтернативный путь к SQL-дампу
# DB_DUMP_PATH=./.docker/mysql/dump.sql
